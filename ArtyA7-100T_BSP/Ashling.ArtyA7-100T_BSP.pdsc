<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.7" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.7/schema/PACK.xsd">
  <vendor>Ashling</vendor>
  <url>https://ashlingmicrosystems.github.io/ashling-cmsis-packs/ArtyA7-100T_BSP/</url>
  <name>ArtyA7-100T_BSP</name>
  <description>Board Support Pack for the Digilent Arty A7-100T FPGA board, running a synthesised SiFive E-Series RISC-V core.</description>
  <license>LICENSE.txt</license>

  <releases>
    <release version="1.0.0" date="2026-09-21">
      Initial release: Arty A7-100T board declaration, mounted with a SiFive E31 core.
    </release>
  </releases>

  <keywords>
    <keyword>RISC-V</keyword>
    <keyword>SiFive</keyword>
    <keyword>Arty</keyword>
    <keyword>BSP</keyword>
  </keywords>

  <requirements>
    <packages>
      <package name="SiFive_E_DFP" vendor="Ashling"/>
    </packages>
  </requirements>

  <boards>
    <board vendor="Digilent" name="Arty A7-100T">
      <description>Digilent Arty A7-100T Artix-7 FPGA development board, synthesised with a SiFive E-Series RISC-V core.</description>
      <mountedDevice Dvendor="Generic:5" Dname="E31"/>
    </board>
  </boards>
</package>
