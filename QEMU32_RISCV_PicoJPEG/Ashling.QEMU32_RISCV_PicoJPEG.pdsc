<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.7" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/v1.7.7/schema/PACK.xsd">
  <vendor>Ashling</vendor>
  <url>https://ashlingmicrosystems.github.io/ashling-cmsis-packs/QEMU32_RISCV_PicoJPEG/</url>
  <name>QEMU32_RISCV_PicoJPEG</name>
  <description>Bare-metal RV32IA picojpeg JPEG-decode example, built with CMake, run under QEMU's virt machine model.</description>
  <license>LICENSE.txt</license>

  <releases>
    <release version="1.0.0" date="2026-07-29">
      Initial release: picojpeg RV32IA/QEMU CMake example.
    </release>
  </releases>

  <keywords>
    <keyword>RISC-V</keyword>
    <keyword>RV32IA</keyword>
    <keyword>QEMU</keyword>
    <keyword>PicoJPEG</keyword>
    <keyword>JPEG</keyword>
    <keyword>Bare-metal</keyword>
    <keyword>CMake</keyword>
  </keywords>

  <!-- No <boards> section: packchk requires every declared board to have a
       <mountedDevices> entry, but Open-CMSIS-Pack's device model (Dcore, Dfpu,
       Dmpu, Dtz, ...) is Arm Cortex-M/R/A specific and has no representation
       for a RISC-V core. The target (QEMU's "virt" machine, RV32IA, RAM at
       0x80000000 per src/link.ld) is documented in prose below and in
       Abstract.txt instead. -->

  <examples>
    <example name="picojpeg" doc="Abstract.txt" folder=".">
      <description>Decode a JPEG image with picojpeg on bare-metal RV32IA, running under QEMU's virt machine.</description>
      <project>
        <environment name="cmake" load="CMakeLists.txt"/>
      </project>
      <attributes>
        <category>Getting Started</category>
      </attributes>
    </example>
  </examples>
</package>
